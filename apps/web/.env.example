# Адрес oRPC-эндпоинта api (по умолчанию http://localhost:3001/rpc)
VITE_API_URL=http://localhost:3001/rpc
# Адрес auth-эндпоинта better-auth (по умолчанию http://localhost:3001/api/auth)
VITE_AUTH_URL=http://localhost:3001/api/auth
# "1" — запросы обрабатывает in-process мок (разработка без запущенного api)
VITE_USE_MOCKS=1
