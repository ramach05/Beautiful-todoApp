# api oRPC endpoint address (defaults to http://localhost:3001/rpc)
VITE_API_URL=http://localhost:3001/rpc
# better-auth auth endpoint address (defaults to http://localhost:3001/api/auth)
VITE_AUTH_URL=http://localhost:3001/api/auth
# "1" — requests are handled by the in-process mock (development without a running api)
VITE_USE_MOCKS=1
# Sentry DSN; without it Sentry is disabled
# VITE_SENTRY_DSN=
