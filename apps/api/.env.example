DATABASE_URL=postgres://todo:todo@localhost:5433/beautiful_todo
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
# Секрет better-auth (минимум 32 символа); в dev/test можно не задавать
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# Лимит POST-запросов к auth на IP за минуту; прод занижает (например 10)
AUTH_RATE_LIMIT_MAX=20
# Адреса/CIDR прокси списком через запятую: request.ip из X-Forwarded-For только для peer отсюда
# TRUST_PROXY=
# DSN Sentry; без него Sentry отключен
# SENTRY_DSN=
