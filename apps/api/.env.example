DATABASE_URL=postgres://todo:todo@localhost:5433/beautiful_todo
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:5173
# better-auth secret (at least 32 characters); optional in dev/test
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
# auth POST requests per IP per minute; prod lowers it (e.g. 10)
AUTH_RATE_LIMIT_MAX=20
# Comma-separated proxy addresses/CIDRs: request.ip from X-Forwarded-For only for peers from this list
# TRUST_PROXY=
# Sentry DSN; without it Sentry is disabled
# SENTRY_DSN=
