{
  "name": "beautiful-todoapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "fsd:check": "turbo run fsd:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "mutation": "pnpm -r run mutation",
    "test:e2e": "pnpm --filter @bt/e2e e2e",
    "lighthouse": "pnpm --filter @bt/web run lhci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@bt/config": "workspace:*",
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "eslint": "^10",
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^6.0.3"
  }
}
